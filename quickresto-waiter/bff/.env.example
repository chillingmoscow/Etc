# Скопируйте этот файл в .env и подставьте боевые значения.
# БЕЗ этих значений BFF работает в MOCK-режиме (демо без QuickResto).
# .env в гит НЕ коммитить (см. .gitignore).

# Поддомен вашего аккаунта: https://<QR_LAYER>.quickresto.ru
QR_LAYER=
# Логин/пароль API из бэк-офиса: Предприятие → Настройки
QR_LOGIN=
QR_PASSWORD=

# Принудительный MOCK (1/true) даже при наличии кредов — для демо
QR_MOCK=

# Порт BFF
PORT=8787

# --- Параметры, подтверждаемые в Фазе 0 (можно не трогать до спайка) ---
# QR_TABLES_MODULE=front.rooms
# QR_TABLES_CLASS=ru.edgex.quickresto.modules.front.rooms.RestaurantTable
# QR_CREATE_MODULE=order.order
# QR_CREATE_CLASS=ru.edgex.quickresto.modules.order.order.Order
# QR_TABLE_FIELD=tableId
# QR_HALL_FIELD=
